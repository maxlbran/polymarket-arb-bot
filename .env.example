# PolyKalshi Arb Engine — Environment Variables
# Copy to .env and fill in real values

# Kalshi API credentials (required for live trading endpoints)
KALSHI_API_KEY=your_kalshi_api_key_here
KALSHI_API_SECRET=your_kalshi_api_secret_here
KALSHI_EMAIL=your_kalshi_email@example.com
KALSHI_PASSWORD=your_kalshi_password_here

# Polymarket API credentials (optional — public endpoints work without auth)
POLYMARKET_API_KEY=your_polymarket_api_key_here

# Alert configuration
ALERT_SOUND=true          # Play terminal bell on TIER 1 opportunity
LOG_LEVEL=INFO            # DEBUG, INFO, WARNING, ERROR

# Scan overrides (optional — defaults in config.py)
# SCAN_INTERVAL_MINUTES=10
# MIN_NET_SPREAD=0.03
